model Speciality {
    id String @id @default(uuid())

    title       String  @unique @db.VarChar(100)
    description String? @db.Text
    icon        String? @db.VarChar(100)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    isDeleted         Boolean           @default(false)
    deletedAt         DateTime?
    doctorSpecialties DoctorSpecialty[]

    @@index([isDeleted], name: "idx_speciality_delete")
    @@index([title], name: "idx_speciality_title")
    @@map("specialities")
}

model DoctorSpecialty {
    id          String @id @default(uuid(7))
    doctorId    String
    specialtyId String

    doctor    Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    specialty Speciality @relation(fields: [specialtyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([doctorId], name: "idx_doctor_specialty_doctor")
    @@index([specialtyId], name: "idx_doctor_specialty_specialty")
    @@map("doctor_specialties")
}
